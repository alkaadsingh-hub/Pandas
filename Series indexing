#slicing
#in slicing negative indxing works
vk = pd.read_csv("kohli_ipl.csv")
vk1 = vk["runs"]

print(vk1[5:20])
print(vk1[20:35])
print(vk1[-8:])   #it will print last 5 runs




#fancy indexing:-
#it will print accorrding to our indexing 
#use double square brackets in fancy indexing.

print(vk1[[1, 3, 5, 7]])  #thiswill print 1st, 3rd, 5th, and 7th match runs of kohli.



